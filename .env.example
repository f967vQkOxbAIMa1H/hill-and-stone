# ─────────────────────────────────────────────────────────────────────────────
# Hill & Stone environment variables
# Local development: copy to .env and keep the local values marked below.
# Production (Netlify): set these under Site configuration → Environment variables, or with
# `netlify env:set NAME value --secret` for secrets. Never commit real values. `npm run check:launch`
# verifies them. docs/DEPLOY-NETLIFY.md has the full deploy order.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site address ─────────────────────────────────────────────────────────────

# Canonical public address, no trailing slash: metadata, canonical tags, sitemap, robots.txt, structured
# data, quote and review links in emails, and Stripe return URLs.
# Local development: use http://localhost:3000 in your .env instead.
NEXT_PUBLIC_APP_URL="https://www.hillandstonehome.com"

# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Local dev: `docker compose up -d` serves this one:
#   postgresql://hillstone:hillstone@localhost:5433/hillstone?schema=public
# Netlify: don't set it. Netlify Database supplies NETLIFY_DB_URL automatically and src/lib/db.ts uses it.
# Set it only in your shell when running a script against production (seed, admin:create); get the
# string from `netlify database status --show-credentials`.
DATABASE_URL="postgresql://hillstone:hillstone@localhost:5433/hillstone?schema=public"

# DIRECT_URL is not used: Netlify Database applies migrations itself on each deploy (see docs).

# ── Admin ────────────────────────────────────────────────────────────────────

# The owner login that `npm run admin:create` creates. It prints a one-time password once; only its hash
# is stored. Not needed by the running site; set it in your shell for that command.
ADMIN_EMAIL="tdavidsonmanagement@outlook.com"
# Optional display name for that login.
# ADMIN_NAME="Hill & Stone"

# Sessions are random tokens stored hashed in the database, so there's no separate auth secret to set.

# ── Email (Resend) ───────────────────────────────────────────────────────────

# https://resend.com/api-keys. Secret. Without it, emails are logged to the console and not sent.
RESEND_API_KEY=""
# Sender for every email. The domain must be verified in Resend.
EMAIL_FROM="Hill & Stone Home Solutions <quotes@hillandstonehome.com>"
# Reply-To for any email that doesn't set its own. Customer emails already reply to the public contact
# email from /admin/settings/site, so keep this the same address.
EMAIL_REPLY_TO="tdavidsonmanagement@outlook.com"
# The business inbox: new requests, accepted quotes, certificate requests and low-rating review feedback
# (subject starts "[Feedback/Low-Rating]"). Also use it as the Stripe account email.
# (CONTRACTOR_NOTIFY_EMAIL, the older name, still works.)
ADMIN_NOTIFICATION_EMAIL="tdavidsonmanagement@outlook.com"

# ── Payments (Stripe) ────────────────────────────────────────────────────────

# https://dashboard.stripe.com/apikeys. Secret. Use sk_test_ keys until ready to take real payments.
# Checkout offers whatever payment methods are on under Settings → Payment methods in the dashboard.
STRIPE_SECRET_KEY=""
# Not used by the hosted Checkout flow; kept for embedded payments later.
STRIPE_PUBLISHABLE_KEY=""
# Signing secret for the webhook endpoint https://www.hillandstonehome.com/api/webhooks/stripe. Secret.
# Locally, `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints one.
STRIPE_WEBHOOK_SECRET=""

# ── Scheduled jobs ───────────────────────────────────────────────────────────

# Protects /api/cron/expire-quotes, which netlify/functions/expire-quotes.mts calls daily. Secret.
# Any long random string, e.g. `openssl rand -base64 32`.
CRON_SECRET=""

# ── Uploaded photos ──────────────────────────────────────────────────────────

# "local" (default) writes to ./storage and needs a persistent disk: local development only.
# Netlify: "netlify" (Netlify Blobs, no keys needed). Set NETLIFY_BLOBS_STORE=uploads-preview in the
# deploy-preview and branch-deploy contexts so previews don't share production's photos.
# Other hosts: "s3" with AWS S3, Cloudflare R2 or MinIO and the STORAGE_* values below.
STORAGE_DRIVER="local"
# NETLIFY_BLOBS_STORE="uploads"
STORAGE_BUCKET=""
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com   AWS: leave blank and set STORAGE_REGION
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# "true" for MinIO and some S3-compatible services
STORAGE_FORCE_PATH_STYLE="false"

# ── Analytics (optional) ─────────────────────────────────────────────────────

# Google Analytics 4 measurement ID (G-XXXXXXX). Read at build time: redeploy after changing it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Local development and testing only (never set in production) ─────────────

# `SEED_DEMO=true npm run db:seed` loads sample projects, placeholder reviews and a demo login
# (`npm run db:reset` does this for you). The production seed loads none of it.
# SEED_DEMO="true"
# Show those sample projects and reviews on the public site.
# SHOW_SAMPLE_CONTENT="1"
# Allow the demo seed to run against a non-local database:
# ALLOW_SAMPLE_SEED="1"
# Route the Stripe SDK to stripe-mock: docker compose --profile test up -d
# STRIPE_API_HOST="localhost"
# STRIPE_API_PORT="12111"
# STRIPE_API_PROTOCOL="http"
