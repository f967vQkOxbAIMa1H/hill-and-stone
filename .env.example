# ─────────────────────────────────────────────────────────────────────────────
# Hill & Stone environment variables
# Copy to .env for local development. In production, set these in your host's
# environment settings. `npm run check:launch` verifies them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required in production ───────────────────────────────────────────────────

# PostgreSQL connection string. Local dev: `docker compose up -d` uses this default.
# Not needed on Netlify: Netlify Database supplies the connection there.
DATABASE_URL="postgresql://hillstone:hillstone@localhost:5433/hillstone?schema=public"

# Public address of the site, no trailing slash. Used in quote links, emails,
# meta tags and Stripe return URLs, so it must be your real https:// domain in production.
# The Hillstone domain isn't purchased yet: keep localhost:3000 for now, then set it here
# and in brand.domain (src/lib/site.ts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (https://resend.com): API key, and a sender on a domain you've verified there.
RESEND_API_KEY=""
EMAIL_FROM="Hill & Stone <quotes@hillstone.com>"

# The central business inbox: new requests, accepted/declined quotes, certificate requests and
# low-rating review feedback (subject starts "[Feedback/Low-Rating]"; filter those into a
# Feedback/Low-Rating folder). Also use this address as the Stripe account email.
CONTRACTOR_NOTIFY_EMAIL="owner@hillstone.com"

# Stripe (https://dashboard.stripe.com/apikeys). Use sk_test_ keys until you're ready to take real payments.
STRIPE_SECRET_KEY=""
# Signing secret for the webhook endpoint https://<your-domain>/api/webhooks/stripe.
# Locally, `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints one.
STRIPE_WEBHOOK_SECRET=""

# Protects the daily quote-expiry job (/api/cron/expire-quotes). Any long random string,
# e.g. `openssl rand -base64 32`. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=""

# ── Optional ────────────────────────────────────────────────────────────────

# Show the sample projects (placeholder photos) and sample reviews from `SEED_DEMO=true npm run db:seed`
# on the public site. Leave unset in production: the gallery stays empty until real photos
# are uploaded in the admin.
# SHOW_SAMPLE_CONTENT="1"

# Not used by the current hosted Checkout flow; keep for embedded payments later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Google Analytics 4 measurement ID (G-XXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Where uploaded photos are stored. "local" (default) writes to ./storage and needs a persistent
# disk. On Netlify use "netlify" (Netlify Blobs; optional NETLIFY_BLOBS_STORE names the store).
# On other serverless hosts use "s3" with AWS S3, Cloudflare R2 or MinIO.
STORAGE_DRIVER="local"
STORAGE_BUCKET=""
# R2: https://<account-id>.r2.cloudflarestorage.com   AWS: leave blank and set STORAGE_REGION
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# "true" for MinIO and some S3-compatible services
STORAGE_FORCE_PATH_STYLE="false"

# ── Local testing only (never set in production) ────────────────────────────
# Route the Stripe SDK to stripe-mock: docker compose --profile test up -d
# STRIPE_API_HOST="localhost"
# STRIPE_API_PORT="12111"
# STRIPE_API_PROTOCOL="http"
# Allow the sample seed to run against a non-local database:
# ALLOW_SAMPLE_SEED="1"
